{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static files only: Vite builds into dist/ and Cloudflare serves them as they are.
  "name": "soundstage",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "soundstage.sagebaggott.com",
      "custom_domain": true
    }
  ]
}
